{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/check-well-known.mjs && next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/backup-subscribers",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/email-sequence",
      "schedule": "0 9 * * *"
    }
  ]
}
